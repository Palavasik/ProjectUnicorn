# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here

# Database: при задании DATABASE_URL миграции выполняются при старте (ORM), таблицы users/feedback создаются автоматически.
# Для Supabase: Settings → Database → Connection string (URI), например:
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Redis Configuration (опционально)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# Application Settings
# DEBUG=False
# LOG_LEVEL=INFO

# OpenRouter (поиск маршрутов через LLM; ключ не коммитить)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_APP_TITLE=Project Unicorn
# OPENROUTER_HTTP_REFERER=https://...
# ROUTE_PROMPT_PATH=config/prompts/route_search.txt

# Supabase REST (опционально): если DATABASE_URL не задан, используется Supabase API для users/feedback.
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_KEY=your_service_role_key_from_supabase_dashboard

# Railway / webhook (только для деплоя; локально не задавать)
# WEBHOOK_URL=https://your-app.up.railway.app
# PORT задаётся Railway автоматически
