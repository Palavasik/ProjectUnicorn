# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here

# Database Configuration (если используется)
# DATABASE_URL=sqlite:///./data/bot.db
# или для PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Redis Configuration (опционально)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# Application Settings
# DEBUG=False
# LOG_LEVEL=INFO

# OpenAI (поиск маршрутов через LLM)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# ROUTE_PROMPT_PATH=config/prompts/route_search.txt

# Railway / webhook (только для деплоя; локально не задавать)
# WEBHOOK_URL=https://your-app.up.railway.app
# PORT задаётся Railway автоматически
